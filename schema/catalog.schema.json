{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstallRouteur public catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "catalog_version", "generated_at", "entries"],
  "properties": {
    "format": {"const": "installrouteur.catalog.v1"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\.[0-9]+\.[0-9]+$", "maxLength": 32},
    "generated_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "entries": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "safeText": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\u0000-\u001F<>:|?*]+$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "aliases", "category", "subcategory"],
      "properties": {
        "canonical_name": {"$ref": "#/$defs/safeText"},
        "aliases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/safeText"}, "uniqueItems": true},
        "category": {"$ref": "#/$defs/safeText"},
        "subcategory": {"$ref": "#/$defs/safeText"}
      }
    }
  }
}
